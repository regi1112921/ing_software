{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/autenticacion/:ruta*", "destination": "https://huellas-autenticacion-e8jv.onrender.com/:ruta*" },
    { "source": "/api/veterinaria/:ruta*", "destination": "https://huellas-veterinaria-nuzw.onrender.com/:ruta*" },
    { "source": "/api/adopcion/:ruta*", "destination": "https://huellas-adopcion-roix.onrender.com/:ruta*" },
    { "source": "/api/dashboard/:ruta*", "destination": "https://huellas-dashboard-tms3.onrender.com/:ruta*" },
    { "source": "/api/voluntariado/:ruta*", "destination": "https://huellas-voluntariado.onrender.com/:ruta*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
