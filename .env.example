# Copia este archivo como .env (en la raíz del repositorio) y completa los valores.
# .env está en .gitignore: nunca subas la contraseña de la base de datos.

# Base de datos (Supabase → Connect → Session pooler). Reemplaza [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# false solo para un PostgreSQL local sin SSL
DB_SSL=true
DB_POOL_MAX=5

# Puertos de los servicios
VETERINARIA_PORT=3001
ADOPCION_PORT=3002
DASHBOARD_PORT=3003
AUTENTICACION_PORT=3004

# URL que usan los demás servicios para validar la sesión
AUTENTICACION_URL=http://localhost:3004
# Duración de una sesión
SESION_HORAS=8

# Orígenes permitidos por CORS, separados por comas (* = cualquiera)
CORS_ORIGENES=*
